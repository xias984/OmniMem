# Copia questo file in .env e modifica i valori se necessario.
# Con docker-compose i default vanno già bene così.

# Porta del bridge server (default: 3000)
# PORT=3000

# URL ChromaDB — dentro docker usa il service name, fuori docker usa localhost
# CHROMA_URL=http://localhost:8000

# URL Ollama — dentro docker usa il service name, fuori docker usa localhost
# OLLAMA_BASE=http://localhost:11434

# Modello embedding (default: nomic-embed-text)
# EMBED_MODEL=nomic-embed-text

# Cartella host montata in /workspace dentro il container per /api/ingest-codebase.
# Default: la directory dove sta docker-compose.yml.
# Esempio per ingestare progetti sotto C:\daniel: CODEBASE_HOST_PATH=C:\daniel
# CODEBASE_HOST_PATH=.

# Token richiesto (header X-OmniMem-Token) per usare le /api/*.
# Se lasciato vuoto/non impostato, le API restano aperte senza autenticazione
# (va bene solo se il server è raggiungibile esclusivamente da localhost).
# Impostalo prima di esporre il server in rete (es. tramite Tailscale) e usa
# lo stesso valore nell'estensione Chrome e nel client mobile.
# API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Hybrid GraphRAG (Neo4j) — vedi docs/graph-rag-architecture.md e
# docs/graph-rag-operations.md. Tutti i flag di default sono "false": il
# sistema si comporta esattamente come oggi (solo ChromaDB) finché non li
# attivi esplicitamente.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch: se true, il retriever ibrido (ChromaDB + Neo4j) diventa
# quello attivo per /api/query (con fallback automatico al solo vettoriale
# in caso di problemi). Se false, comportamento identico al RAG attuale.
# OMNIMEM_GRAPHRAG_ENABLED=false

# Se true, ogni nuovo chunk salvato in ChromaDB viene anche indicizzato nel
# knowledge graph (dual write asincrono, non bloccante). Puoi tenerlo attivo
# anche con OMNIMEM_GRAPHRAG_ENABLED=false per popolare il grafo prima di
# usarlo in produzione ("dual indexing").
# OMNIMEM_GRAPH_INDEXING_ENABLED=false

# Se true, ogni query esegue anche il retrieval ibrido in parallelo a quello
# vettoriale (che resta l'unico usato per la risposta) e logga latenze,
# conteggi e differenze — utile per validare il grafo prima di affidargli
# le risposte reali.
# OMNIMEM_GRAPH_SHADOW_MODE=false

# Connessione a Neo4j (avviato con `docker compose --profile with-graphrag up neo4j`,
# oppure `docker compose up neo4j` se preferisci non usare i profile).
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=cambiami-in-locale
# NEO4J_DATABASE=neo4j

# Provider dello structured knowledge extractor: "ollama" (locale, stesso
# host degli embedding) oppure "none" (nessuna estrazione, solo struttura
# Memory/Chunk nel grafo). Mai chiamate LLM per generare query Cypher.
# OMNIMEM_EXTRACTOR_PROVIDER=ollama
# OMNIMEM_EXTRACTOR_MODEL=llama3.1

# Percorso (relativo alla cartella server/) dove viene salvato il checkpoint
# di backfill e la dead-letter delle indicizzazioni grafo fallite in modo
# definitivo (dopo i retry). Vedi `npm run graph:backfill`.
# OMNIMEM_GRAPH_BACKFILL_CHECKPOINT_PATH=data/graph-backfill-checkpoint.json
# OMNIMEM_GRAPH_DEAD_LETTER_PATH=data/graph-dead-letter.jsonl

# Come sopra, ma per le cancellazioni di namespace fallite in modo definitivo
# (DELETE /api/topics/:topic quando la pulizia di Neo4j non riesce nemmeno
# dopo i retry): ChromaDB e' gia' stato ripulito, questo file registra quali
# namespace vanno ripuliti manualmente nel grafo.
# OMNIMEM_GRAPH_DELETE_DEAD_LETTER_PATH=data/graph-delete-dead-letter.jsonl
