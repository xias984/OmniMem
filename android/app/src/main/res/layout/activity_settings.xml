<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/field_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_server_url"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/field_api_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_api_token"
        android:inputType="textPassword"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/field_topic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_topic"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_save"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_open_accessibility_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_accessibility_settings"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btn_open_overlay_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_overlay_settings"
        android:layout_marginTop="8dp" />

</LinearLayout>
